---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { coverImageWidths, getArticles, imageDimensionAttributes, optimizedImageSrcset, optimizedImageUrl, originalImageUrl } from "../../lib/articles.js";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const publicationDate = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeStyle: "short" }).format(article.date);
const cover = optimizedImageUrl(article.thumbnail, 1280);
const originalCover = originalImageUrl(article.thumbnail);
---

<BaseLayout
  title={`${article.title} – Quartz Report`}
  description={article.description}
  image={originalCover}
  article
  articleData={{
    title: article.title,
    author: article.author,
    category: article.category,
    publishedAt: article.date,
    imageAlt: `Illustration de l'article ${article.title}`,
  }}
>
  <Header />
  <main class="articles">
    <article class="article-full">
      <div class="article-cover-scene"><div class="article-cover"><span class="article-cover__aura" aria-hidden="true"><img class="article-cover__ambient" src={cover} alt="" decoding="async" /><img class="article-cover__halo" src={cover} alt="" decoding="async" /></span><span class="article-cover-image-mask-x"><span class="article-cover-image-mask-y"><img class="article-cover__image" src={cover} data-image-fallback={originalCover} srcset={optimizedImageSrcset(article.thumbnail, coverImageWidths)} sizes="(min-width: 60rem) 60rem, 100vw" {...imageDimensionAttributes(article.thumbnailDimensions)} alt="Illustration de l'article" loading="eager" decoding="async" /></span></span></div></div>
      <header class="article-header"><h1>{article.title}</h1></header>
      <section class="article-body" set:html={article.bodyHtml}></section>
      <footer class="article-contributor" data-contributor-card={article.authorGithubId ? true : undefined} data-contributor-id={article.authorGithubId || undefined} hidden={!article.authorGithubId}>
        <img data-contributor-avatar alt="" hidden>
        <p>Par <strong data-contributor-name>{article.author}</strong>, le {publicationDate}</p>
      </footer>
    </article>
  </main>
</BaseLayout>
