---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { coverImageWidths, getArticles, imageDimensionAttributes, optimizedImageSrcset, optimizedImageUrl, originalImageUrl } from "../../lib/articles.js";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const date = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(article.date);
const cover = optimizedImageUrl(article.thumbnail, 1280);
const originalCover = originalImageUrl(article.thumbnail);
---

<BaseLayout
  title={`${article.title} – Quartz Report`}
  description={article.description}
  image={originalCover}
  article
  articleData={{
    title: article.title,
    author: article.author,
    category: article.category,
    publishedAt: article.date,
    imageAlt: `Illustration de l'article ${article.title}`,
  }}
>
  <Header />
  <main class="articles">
    <article class="article-full">
      <div class="article-cover"><img src={cover} data-image-fallback={originalCover} srcset={optimizedImageSrcset(article.thumbnail, coverImageWidths)} sizes="100vw" {...imageDimensionAttributes(article.thumbnailDimensions)} alt="Illustration de l'article" loading="eager" decoding="async" /></div>
      <header class="article-header"><h1>{article.title}</h1><p class="article-meta">Par <span data-contributor-name={article.authorGithubId ? true : undefined} data-contributor-id={article.authorGithubId || undefined}>{article.author}</span>, le {date}</p></header>
      <section class="article-body" set:html={article.bodyHtml}></section>
      <footer class="article-contributor" data-contributor-card={article.authorGithubId ? true : undefined} data-contributor-id={article.authorGithubId || undefined} hidden={!article.authorGithubId}>
        <img data-contributor-avatar alt="" hidden>
        <p>Par <strong data-contributor-name>{article.author}</strong></p>
      </footer>
    </article>
  </main>
</BaseLayout>
