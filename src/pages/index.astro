---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ArticleList from "../components/ArticleList.astro";
import { cardImageWidths, getArticles, imageDimensionAttributes, optimizedImageSrcset, optimizedImageUrl } from "../lib/articles.js";

const articles = await getArticles();
const featured = articles.filter((article) => article.important);
const categories = ["Tous", "Apple", "Analyse", "Comparatif", "Review", "Autre"].filter((category) => category === "Tous" || articles.some((article) => article.category === category));
const shortDate = (date) => new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "short" }).format(date);
---

<BaseLayout>
  <Header />
  <nav class="main-nav" aria-label="Catégories"><ul id="categories">
    {categories.map((category, index) => <li><a href="#articles" class:list={["category-filter", { active: index === 0 }]} data-category={category}>{category}</a></li>)}
  </ul></nav>
  <section class="hottest"><div class="hottest-wrapper"><div class="hottest-grid" id="hottest">
    <div class="card hottest-spacer" aria-hidden="true"></div>
    {featured.map((article, index) => (
      <a href={`/articles/${encodeURIComponent(article.slug)}/`} class="card" data-category={article.category}>
        <div class="card-inner"><img src={optimizedImageUrl(article.thumbnail, 768)} srcset={optimizedImageSrcset(article.thumbnail, cardImageWidths)} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" {...imageDimensionAttributes(article.thumbnailDimensions)} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          <div class="card-content"><p class="card-meta">Par {article.author}, {shortDate(article.date)}</p><h3>{article.title}</h3></div>
        </div>
      </a>
    ))}
  </div></div></section>
  <h2 class="all-articles-title">Tous les articles</h2>
  <div id="articles"><ArticleList articles={articles} /></div>
  <script src="/js/category-filter.js" defer></script>
</BaseLayout>
