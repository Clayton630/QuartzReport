{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "quartzreport-oauth",
  "main": "index.js",
  "compatibility_date": "2026-09-05",
  "d1_databases": [
    {
      "binding": "PROFILES_DB",
      "database_name": "quartzreport-profiles",
      "database_id": "abacd763-ac11-49dd-be84-a641edfccec5",
      "migrations_dir": "migrations"
    },
    {
      "binding": "DRAFTS_DB",
      "database_name": "quartzreport-drafts",
      "database_id": "d9a5d516-b677-44b2-a868-de31183a2b58",
      "migrations_dir": "drafts-migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
