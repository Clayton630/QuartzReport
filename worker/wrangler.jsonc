{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "quartzreport-oauth",
  "main": "index.js",
  "compatibility_date": "2026-09-05",
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
